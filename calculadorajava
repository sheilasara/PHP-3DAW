<!DOCTYPE html>
<html>
<body>

<h1>Minha Calculadora!</h1>

<form onsubmit="calcular(); return false;">
    
    a:<input type="text" id="a"><br>

    b:<input type="text" id="b"><br>

    <br>Operação:

    <br><input type="radio" name="operador" value="soma"> Soma
    <br><input type="radio" name="operador" value="sub"> Subtrai
    <br><input type="radio" name="operador" value="multi"> Multiplica
    <br><input type="radio" name="operador" value="divide"> Divide

    <br><br>

    <input type="submit" value="Calcular">

</form>

<h2 id="resultado"></h2>

<script>

function calcular() {

    let a = parseFloat(document.getElementById("a").value);
    let b = parseFloat(document.getElementById("b").value);

    let operador = document.querySelector('input[name="operador"]:checked');

    let resultado = 0;

    if (!operador) {
        document.getElementById("resultado").innerHTML = "Escolha uma operação";
        return;
    }

    if (operador.value == "soma") {
        resultado = a + b;

    } else if (operador.value == "sub") {
        resultado = a - b;

    } else if (operador.value == "multi") {
        resultado = a * b;

    } else if (operador.value == "divide") {
        resultado = a / b;

    } else {
        document.getElementById("resultado").innerHTML = "Operador não definido";
        return;
    }

    document.getElementById("resultado").innerHTML =
        "Resultado: " + resultado;
}

</script>

</body>
</html>
